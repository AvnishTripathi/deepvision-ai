# ==============================================================================
# DeepVision AI — Environment Configuration (Step 1 Foundation)
# ==============================================================================

# --- Application Identity ---
PROJECT_NAME="DeepVision AI"
PROJECT_VERSION="1.0.0-step1"
APP_ENV=development
APP_DEBUG=true

# --- Backend Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL Ready with SQLite dev fallback) ---
# For Local Dev without Docker running:
DATABASE_URL=sqlite:///./deepvision.db
# For Docker / Production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepvision

# --- Cache & Task Queue (Redis Ready) ---
REDIS_URL=redis://localhost:6379/0

# --- Security & JWT Auth ---
SECRET_KEY=deepvision-ai-super-secure-production-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage & File Limits ---
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# --- Frontend Client ---
VITE_APP_TITLE="DeepVision AI"
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
