# ==============================================================================
# DeepVision AI — Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="DeepVision AI"
PROJECT_VERSION="1.0.0-dev"
APP_ENV="development"
DEBUG=true

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deepvision_db"
# Fallback SQLite example:
# DATABASE_URL="sqlite:///./deepvision.db"

# Redis Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"

# Security
SECRET_KEY="generate-a-strong-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Networking & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# File & Storage Limits
STORAGE_DIR="./storage"
MODELS_DIR="./models"
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
