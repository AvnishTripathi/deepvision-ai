# ==============================================================================
# DeepVision AI — Environment Configuration Example (.env.example)
# Copy this file to .env and customize values for your deployment.
# Do NOT store real production secrets in this file.
# ==============================================================================

# Application Metadata
APP_NAME=DeepVision AI
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/deepvision_db

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# AI Engine & Model Inference Settings
AI_DEVICE=auto
AI_MODEL_NAME=scrfd_500m
AI_MODEL_VERSION=1.0.0
AI_CONFIDENCE_THRESHOLD=0.50
AI_NMS_THRESHOLD=0.30
AI_MAX_IMAGE_SIZE_MB=10
AI_MAX_IMAGE_DIMENSION=4096
AI_ENABLE_GPU=false

# ==============================================================================
# Pipeline Modular Feature Toggles (Step 19)
# ==============================================================================
# Enable or disable 5-point facial landmark geometry extraction
AI_ENABLE_LANDMARKS=true

# Enable or disable multi-factor face quality assessment (clarity, illumination, size)
AI_ENABLE_QUALITY_ANALYSIS=true

# Enable or disable 3D head pose estimation (Yaw, Pitch, Roll via solvePnP)
AI_ENABLE_POSE_ANALYSIS=true

# ==============================================================================
# Face Quality & Optics Configurable Thresholds (Step 19)
# ==============================================================================
# Minimum Laplacian variance threshold below which a face crop is marked blurry (float >= 0.0)
FACE_BLUR_THRESHOLD=50.0

# Minimum photopic luminance (0-255) below which a face is marked too_dark (float in [0, 255])
FACE_BRIGHTNESS_MIN=60.0

# Maximum photopic luminance (0-255) above which a face is marked too_bright (float in [0, 255])
FACE_BRIGHTNESS_MAX=200.0

# Minimum composite face quality score (0-100) below which a face is classified as poor/unusable
FACE_QUALITY_THRESHOLD=45.0

# Security (Set strong secrets in production; never commit .env with secrets)
SECRET_KEY=deepvision-ai-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
