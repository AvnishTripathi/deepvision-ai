# ==============================================================================
# DeepVision AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# CRITICAL: Never commit real production secrets or credentials to Git.
# ==============================================================================

# Application Metadata
APP_NAME=DeepVision AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database Connection (PostgreSQL for production; SQLite fallback for local dev)
# Development SQLite: sqlite:///./deepvision.db
# Production PostgreSQL: postgresql://username:password@localhost:5432/deepvision_db
DATABASE_URL=sqlite:///./deepvision.db

# Redis Cache, Message Broker & Rate Limiter Storage
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Allowed HTTP Host Headers (comma-separated or '*' for dev)
ALLOWED_HOSTS=*

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# AI Engine & Model Inference Settings
AI_DEVICE=auto
AI_MODEL_NAME=scrfd_500m
AI_MODEL_VERSION=1.0.0
AI_CONFIDENCE_THRESHOLD=0.50
AI_NMS_THRESHOLD=0.30
AI_MAX_IMAGE_SIZE_MB=10
AI_MAX_IMAGE_DIMENSION=4096
AI_ENABLE_GPU=false

# ==============================================================================
# Pipeline Feature Flags & Thresholds
# ==============================================================================
AI_ENABLE_LANDMARKS=true
AI_ENABLE_QUALITY_ANALYSIS=true
AI_ENABLE_POSE_ANALYSIS=true

FACE_BLUR_THRESHOLD=50.0
FACE_BRIGHTNESS_MIN=60.0
FACE_BRIGHTNESS_MAX=200.0
FACE_QUALITY_THRESHOLD=45.0

# ==============================================================================
# Video Processing & Multi-Face Tracking (ByteTrack)
# ==============================================================================
VIDEO_DETECTION_INTERVAL=1
VIDEO_ANALYSIS_INTERVAL=5
VIDEO_MAX_FPS=
VIDEO_TRACKER_HIGH_THRESHOLD=0.50
VIDEO_TRACKER_LOW_THRESHOLD=0.15
VIDEO_TRACKER_MAX_TIME_LOST=30
VIDEO_TRACKER_MIN_HITS=2

# Video Resource Limits & Security Bounds
VIDEO_MAX_FILE_SIZE_MB=500
VIDEO_MAX_DURATION_SECONDS=600.0
VIDEO_MAX_WIDTH=4096
VIDEO_MAX_HEIGHT=4096
VIDEO_MAX_FRAME_COUNT=18000
VIDEO_MAX_CONCURRENT_JOBS=4

# ==============================================================================
# API Rate Limiting (Step 7.4)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IMAGE_ANALYSIS=60/minute
RATE_LIMIT_VIDEO_ANALYSIS=10/minute

# ==============================================================================
# Security & Secret Keys
# ==============================================================================
# In production, replace SECRET_KEY with a cryptographically secure random string:
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=deepvision-ai-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

