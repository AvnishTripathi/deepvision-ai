# ==============================================================================
# DeepVision AI — Production Environment Template (.env.production.example)
# Hardened settings for secure production deployment.
# ==============================================================================

APP_NAME=DeepVision AI
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Production PostgreSQL Connection
DATABASE_URL=postgresql://deepvision_user:STRONG_SECURE_PASSWORD@postgres:5432/deepvision_db

# Production Redis Cluster or Container
REDIS_URL=redis://redis:6379/0

# Strict CORS: Whitelist only authorized production domains (NO wildcard)
CORS_ORIGINS=https://deepvision.example.com

# Strict Host Header Validation
ALLOWED_HOSTS=deepvision.example.com,api.deepvision.example.com

LOG_LEVEL=WARNING

# Hardware Inference Acceleration
AI_DEVICE=auto
AI_MODEL_NAME=scrfd_500m
AI_MODEL_VERSION=1.0.0
AI_CONFIDENCE_THRESHOLD=0.50
AI_NMS_THRESHOLD=0.30
AI_MAX_IMAGE_SIZE_MB=10
AI_MAX_IMAGE_DIMENSION=4096
AI_ENABLE_GPU=false

# Video Resource Bounds
VIDEO_MAX_FILE_SIZE_MB=500
VIDEO_MAX_DURATION_SECONDS=600.0
VIDEO_MAX_WIDTH=4096
VIDEO_MAX_HEIGHT=4096
VIDEO_MAX_FRAME_COUNT=18000
VIDEO_MAX_CONCURRENT_JOBS=4

# Production Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IMAGE_ANALYSIS=60/minute
RATE_LIMIT_VIDEO_ANALYSIS=10/minute

# Mandatory: Generate strong unique cryptographic secret in production!
# e.g.: openssl rand -base64 48
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30

