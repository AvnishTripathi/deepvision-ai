# ==============================================================================
# DeepVision AI — Git Ignore Rules
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Storage
*.sqlite
*.sqlite3
*.db
deepvision.db
deepfaceguard.db
uploads/
backend/uploads/
*.jpg
*.jpeg
*.png
*.mp4
*.avi
!deepvision-ai/backend/tests/fixtures/*

# Model Binaries & Heavy Weights (Never commit binaries)
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.bin
models/**/*.safetensors
models/**/*.engine
*.onnx
*.pt
*.pth
*.safetensors
!models/**/.gitkeep
!models/.gitkeep

# Environment & Secrets (Never commit secrets)
.env.local
.env.production
*.local

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker volumes / logs
*.log
docker-data/
postgres_data/
redis_data/
